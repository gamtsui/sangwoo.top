---
// AI Customer Service Chat Widget
// Uses Alpine.js for interactivity, calls /api/chat endpoint
---

<div
  x-data="chatWidget()"
  x-init="init()"
  class="fixed bottom-6 right-6 z-50 font-sans"
>
  <!-- Floating Chat Button -->
  <button
    x-show="!isOpen"
    @click="isOpen = true"
    class="w-14 h-14 rounded-full bg-gradient-to-br from-amber-500 to-amber-700 text-white shadow-lg shadow-amber-500/30 hover:shadow-amber-500/50 hover:scale-105 transition-all duration-300 flex items-center justify-center"
    aria-label="Open chat"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>
  </button>

  <!-- Chat Window -->
  <div
    x-show="isOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 translate-y-4 scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 translate-y-4 scale-95"
    @click.away="if (showDropdown) showDropdown = false"
    class="w-80 sm:w-96 bg-[#1a1a1a] rounded-2xl shadow-2xl border border-[#2a2a2a] overflow-hidden flex flex-col"
    style="height: 480px;"
  >
    <!-- Header -->
    <div class="bg-gradient-to-r from-amber-600 to-amber-700 px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-white">AI 客服助手</h3>
          <p class="text-xs text-amber-200" x-text="statusText"></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button @click="clearChat()" class="text-xs text-amber-200 hover:text-white transition-colors" title="Clear chat">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
        <button @click="isOpen = false" class="text-amber-200 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages -->
    <div
      class="flex-1 overflow-y-auto px-4 py-3 space-y-3"
      x-ref="messagesContainer"
    >
      <!-- Welcome message -->
      <template x-if="messages.length === 0">
        <div class="text-center py-8">
          <div class="w-12 h-12 bg-amber-500/20 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <p class="text-sm text-gray-300">您好！我是Sangwoo AI客服</p>
          <p class="text-xs text-gray-500 mt-1">请问有什么可以帮您？</p>
        </div>
      </template>

      <!-- Message bubbles -->
      <template x-for="(msg, idx) in messages" :key="idx">
        <div class="flex" :class="msg.role === 'user' ? 'justify-end' : 'justify-start'">
          <div
            class="max-w-[80%] rounded-2xl px-3.5 py-2 text-sm"
            :class="msg.role === 'user'
              ? 'bg-amber-600 text-white rounded-br-sm'
              : 'bg-[#2a2a2a] text-gray-200 rounded-bl-sm'"
          >
            <p class="whitespace-pre-wrap break-words" x-text="msg.content"></p>
            <span class="text-[10px] opacity-50 mt-1 block" :class="msg.role === 'user' ? 'text-amber-200' : 'text-gray-400'" x-text="msg.time"></span>
          </div>
        </div>
      </template>

      <!-- Loading indicator -->
      <template x-if="loading">
        <div class="flex justify-start">
          <div class="bg-[#2a2a2a] rounded-2xl rounded-bl-sm px-4 py-3 flex items-center gap-1.5">
            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0ms;"></div>
            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 150ms;"></div>
            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 300ms;"></div>
          </div>
        </div>
      </template>
    </div>

    <!-- Quick suggestions -->
    <template x-if="messages.length === 0 && !loading">
      <div class="px-4 pb-2 flex flex-wrap gap-2">
        <button @click="sendSuggestion('有哪些韩国食品？')" class="text-xs bg-[#2a2a2a] text-gray-300 px-3 py-1.5 rounded-full hover:bg-[#333] transition-colors">
          有哪些韩国食品？
        </button>
        <button @click="sendSuggestion('如何联系你们？')" class="text-xs bg-[#2a2a2a] text-gray-300 px-3 py-1.5 rounded-full hover:bg-[#333] transition-colors">
          如何联系你们？
        </button>
        <button @click="sendSuggestion('你们的优势是什么？')" class="text-xs bg-[#2a2a2a] text-gray-300 px-3 py-1.5 rounded-full hover:bg-[#333] transition-colors">
          优势是什么？
        </button>
      </div>
    </template>

    <!-- Input -->
    <div class="border-t border-[#2a2a2a] p-3">
      <form @submit.prevent="sendMessage()" class="flex items-center gap-2">
        <input
          x-model="input"
          type="text"
          :disabled="loading"
          placeholder="输入您的问题..."
          class="flex-1 bg-[#2a2a2a] text-gray-200 text-sm rounded-full px-4 py-2.5 outline-none focus:ring-1 focus:ring-amber-500 placeholder-gray-500 disabled:opacity-50"
        />
        <button
          type="submit"
          :disabled="loading || !input.trim()"
          class="w-10 h-10 bg-amber-600 hover:bg-amber-500 disabled:bg-gray-600 disabled:cursor-not-allowed rounded-full flex items-center justify-center transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </form>
      <p class="text-[10px] text-gray-600 text-center mt-1.5">AI 回复仅供参考，以实际产品为准</p>
    </div>
  </div>
</div>

<script>
  function chatWidget() {
    return {
      isOpen: false,
      loading: false,
      input: '',
      messages: [],
      sessionId: '',
      lang: 'zh',
      statusText: '在线',
      showDropdown: false,

      init() {
        // Load session from localStorage
        this.sessionId = localStorage.getItem('chat_session') || '';
        // Detect language from cookie
        const langCookie = document.cookie.split(';').find(c => c.trim().startsWith('lang='));
        if (langCookie) {
          this.lang = langCookie.split('=')[1] || 'zh';
        }
      },

      getTime() {
        const now = new Date();
        return now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
      },

      scrollToBottom() {
        this.$nextTick(() => {
          if (this.$refs.messagesContainer) {
            this.$refs.messagesContainer.scrollTop = this.$refs.messagesContainer.scrollHeight;
          }
        });
      },

      sendSuggestion(text) {
        this.input = text;
        this.sendMessage();
      },

      async sendMessage() {
        const text = this.input.trim();
        if (!text || this.loading) return;

        this.messages.push({ role: 'user', content: text, time: this.getTime() });
        this.input = '';
        this.loading = true;
        this.statusText = '输入中...';
        this.scrollToBottom();

        try {
          const resp = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: text,
              session_id: this.sessionId,
              lang: this.lang,
            }),
          });

          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const data = await resp.json();

          this.sessionId = data.session_id || this.sessionId;
          if (this.sessionId) localStorage.setItem('chat_session', this.sessionId);

          this.messages.push({ role: 'assistant', content: data.reply, time: this.getTime() });
          this.statusText = '在线';
        } catch (err) {
          this.messages.push({
            role: 'assistant',
            content: this.lang === 'zh'
              ? '抱歉，连接失败，请稍后重试。您也可以通过"联系我们"页面获取帮助。'
              : 'Sorry, connection failed. Please try again later.',
            time: this.getTime(),
          });
          this.statusText = '连接异常';
          console.error('Chat error:', err);
        } finally {
          this.loading = false;
          this.scrollToBottom();
        }
      },

      clearChat() {
        this.messages = [];
        this.sessionId = '';
        localStorage.removeItem('chat_session');
      },
    };
  }
</script>
