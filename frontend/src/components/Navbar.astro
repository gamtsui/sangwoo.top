---
import { getLocale } from '../i18n/locales';

export interface Props {
  locale: 'zh' | 'en';
}

const { locale = 'zh' } = Astro.props;
const t = getLocale(locale);
const prefix = locale === 'en' ? '/en' : '/zh';
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[rgba(10,10,10,0.9)] backdrop-blur-md border-b border-[#2a2a2a]"
     x-data="{ mobileOpen: false }">
  <div class="container flex items-center justify-between h-16">
    <a href={`${prefix}/`} class="text-xl font-bold text-accent">SANGWOO</a>

    <div class="hidden md:flex items-center gap-8">
      <a href={`${prefix}/`} class="text-sm font-medium hover:text-accent transition-colors">{t.nav.home}</a>
      <a href={`${prefix}/products`} class="text-sm font-medium hover:text-accent transition-colors">{t.nav.products}</a>
      <a href={`${prefix}/news`} class="text-sm font-medium hover:text-accent transition-colors">{t.nav.news}</a>
      <a href={`${prefix}/about`} class="text-sm font-medium hover:text-accent transition-colors">{t.nav.about}</a>
      <a href={`${prefix}/contact`} class="text-sm font-medium hover:text-accent transition-colors">{t.nav.contact}</a>
    </div>

    <div class="flex items-center gap-4">
      <div class="flex items-center border border-[#2a2a2a] rounded-lg overflow-hidden">
        <a href={locale === 'zh' ? '/en/' : '/zh/'}
           onclick="document.cookie='lang={locale === 'zh' ? 'en' : 'zh'};path=/;max-age=31536000';return true;"
           class="px-2.5 py-1 text-xs hover:bg-[#1e1e1e] transition-colors">
          {locale === 'zh' ? 'EN' : '中'}
        </a>
      </div>

      <button @click="mobileOpen = !mobileOpen" class="md:hidden p-2 text-muted">
        <svg x-show="!mobileOpen" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg x-show="mobileOpen" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div x-show="mobileOpen" @click.away="mobileOpen = false"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-2"
       x-transition:enter-end="opacity-100 translate-y-0"
       class="md:hidden bg-[#141414] border-b border-[#2a2a2a]">
    <div class="container py-4 flex flex-col gap-4">
      <a href={`${prefix}/`} class="text-sm font-medium hover:text-accent py-2">{t.nav.home}</a>
      <a href={`${prefix}/products`} class="text-sm font-medium hover:text-accent py-2">{t.nav.products}</a>
      <a href={`${prefix}/news`} class="text-sm font-medium hover:text-accent py-2">{t.nav.news}</a>
      <a href={`${prefix}/about`} class="text-sm font-medium hover:text-accent py-2">{t.nav.about}</a>
      <a href={`${prefix}/contact`} class="text-sm font-medium hover:text-accent py-2">{t.nav.contact}</a>
    </div>
  </div>
</nav>
