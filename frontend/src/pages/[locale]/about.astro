---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getLocale } from '../../i18n/locales';
import { fetchAbout } from '../../utils/api';

const urlLocale = Astro.url.pathname.split('/')[1];
const locale = ['zh', 'en'].includes(urlLocale) ? urlLocale : 'zh';
const t = getLocale(locale);
const prefix = locale === 'en' ? '/en' : '/zh';
const about = await fetchAbout();

export function getStaticPaths() {
  return [
    { params: { locale: 'zh' } },
    { params: { locale: 'en' } },
  ];
}

---

<BaseLayout locale={locale} title={`${t.about.title} - Sangwoo`}>
  <Navbar locale={locale} slot="navbar" />

  <section class="section pt-24">
    <div class="container max-w-3xl">
      <h1 class="section-title">{t.about.title}</h1>
      <div class="text-muted leading-relaxed whitespace-pre-wrap mt-6">
        {about ? (locale === 'zh' ? about.content_zh : about.content_en) : (locale === 'zh' ? '内容建设中...' : 'Content coming soon...')}
      </div>
    </div>
  </section>

  <Footer locale={locale} slot="footer" />
</BaseLayout>
