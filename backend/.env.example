# AI Configuration for PLAN4
# AI API Base URL (default: https://sangwoozen.com/v1)
AI_API_BASE=https://sangwoozen.com/v1

# AI API Key (required for AI chat and translation)
# Get your API key from: https://sangwoozen.com
AI_API_KEY=your_api_key_here

# AI Model (default: qwen3-32b)
AI_MODEL=qwen3-32b

# Admin Configuration (optional - can also be set via environment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Secret Key (optional - auto-generated if not set)
# SECRET_KEY=your_secret_key_here
